# ==========================================================
# نموذج ملف البيئة — WiFi Network System
# انسخ هذا الملف إلى backend/.env ثم عدّل القيم
# ==========================================================

# بيئة التشغيل: development محلياً / production على خادم عام
NODE_ENV=development

# منفذ الخادم الخلفي
PORT=3000

# قاعدة البيانات PostgreSQL
# محلياً (مثال): postgresql://wifi:كلمة-المرور@127.0.0.1:5432/wifi_network
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/wifi_network

# ⚠️ أمان — لا تترك القيم الافتراضية أبداً في الإنتاج:
# ولّد مفاتيح قوية عشوائية (انظر الأمرين أدناه)
JWT_SECRET=ضع-هنا-مفتاحاً-عشوائياً-طويلاً
MIKROTIK_ENCRYPTION_KEY=ضع-هنا-مفتاحاً-عشوائياً-32-حرفاً
ADMIN_PASSWORD=ضع-هنا-كلمة-مرور-قوية-للأدمن

# النطاقات المسموح لها بالاتصال (CORS) — مفصولة بفواصل
ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------------------------------------
# توليد مفتاح JWT قوي (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# توليد مفتاح تشفير MikroTik قوي:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ----------------------------------------------------------
